/* ═══════════════════════════════════════
   SCROLL PROGRESS BAR
═══════════════════════════════════════ */
function initScrollBar(){
  const bar=document.createElement('div');
  bar.style.cssText='position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,#FF2D88,#CC88FF,#FF2D88);z-index:2001;width:0%;transition:width 0.1s linear;pointer-events:none;';
  document.body.appendChild(bar);
  window.addEventListener('scroll',()=>{
    bar.style.width=Math.min(100,window.scrollY/(document.documentElement.scrollHeight-window.innerHeight)*100)+'%';
  },{passive:true});
}

/* ═══════════════════════════════════════
   SCROLL REVEAL
═══════════════════════════════════════ */
function initReveal(){
  const obs=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('revealed','visible');obs.unobserve(e.target);}});
  },{threshold:0.06});
  document.querySelectorAll('[data-reveal],.fade-up').forEach(el=>obs.observe(el));
}

/* ═══════════════════════════════════════
   INIT
═══════════════════════════════════════ */
document.addEventListener('DOMContentLoaded',()=>{
  initCursor();
  initNav();
  initCountdown();
  initReveal();
  initScrollBar();
  initStartup();
  setTimeout(()=>{ if(Math.random()<0.3) maybeError(); },10000);
});

