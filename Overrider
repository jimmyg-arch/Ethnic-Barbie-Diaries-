/* ═══════════════════════════════════════
   NAV
═══════════════════════════════════════ */
function initNav(){
  const ham = document.getElementById('hamburger');
  const mob = document.getElementById('nav-mobile');
  if(ham && mob){
    ham.addEventListener('click', () => {
      mob.classList.toggle('open');
      const ss = ham.querySelectorAll('span');
      if(mob.classList.contains('open')){
        ss[0].style.transform = 'rotate(45deg) translate(5px,5px)';
        ss[1].style.opacity = '0';
        ss[2].style.transform = 'rotate(-45deg) translate(5px,-5px)';
      } else {
        ss.forEach(s => { s.style.transform = ''; s.style.opacity = ''; });
      }
    });
  }
  /* Active link */
  const path = window.location.pathname.split('/').pop() || 'index.html';
  document.querySelectorAll('.nav-links a, .nav-mobile a').forEach(a => {
    if((a.getAttribute('href') || '') === path) a.classList.add('active');
  });
  /* Live clock */
  const tray = document.getElementById('nav-tray-time');
  if(tray){
    const tick = () => tray.textContent = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
    tick(); setInterval(tick, 1000);
  }
}

/* ═══════════════════════════════════════
   COUNTDOWN
═══════════════════════════════════════ */
function initCountdown(){
  const el = document.getElementById('countdown');
  if(!el) return;
  const target = new Date('2026-04-16T09:00:00-04:00');
  const pad = n => String(n).padStart(2,'0');
  function update(){
    const diff = target - new Date();
    if(diff <= 0){
      el.innerHTML = '<span style="font-family:\'Nunito\',sans-serif;font-size:14px;font-weight:900;color:var(--pink)">🎉 UBW 2026 is happening NOW!!</span>';
      return;
    }
    const d=Math.floor(diff/86400000), h=Math.floor((diff%86400000)/3600000),
          m=Math.floor((diff%3600000)/60000), s=Math.floor((diff%60000)/1000);
    el.innerHTML = `<div class="cd-row">
      <div class="cd-box"><span class="cd-num">${pad(d)}</span><span class="cd-lbl">Days</span></div>
      <span class="cd-sep blink">:</span>
      <div class="cd-box"><span class="cd-num">${pad(h)}</span><span class="cd-lbl">Hours</span></div>
      <span class="cd-sep blink">:</span>
      <div class="cd-box"><span class="cd-num">${pad(m)}</span><span class="cd-lbl">Min</span></div>
      <span class="cd-sep blink">:</span>
      <div class="cd-box"><span class="cd-num">${pad(s)}</span><span class="cd-lbl">Sec</span></div>
    </div>`;
  }
  update(); setInterval(update, 1000);
}

/* ═══════════════════════════════════════
   TOAST
═══════════════════════════════════════ */
window.showToast = function(msg){
  let t = document.getElementById('y2k-toast');
  if(!t){ t = document.createElement('div'); t.id = 'y2k-toast'; t.className = 'toast'; document.body.appendChild(t); }
  t.textContent = msg; t.classList.add('show');
  clearTimeout(t._to); t._to = setTimeout(() => t.classList.remove('show'), 2800);
};

/* ═══════════════════════════════════════
   TABS
═══════════════════════════════════════ */
window.showTab = function(id, btn){
  document.querySelectorAll('.pg-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.pg-tab').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('tab-' + id);
  if(panel) panel.classList.add('active');
  if(btn) btn.classList.add('active');
  const tabs = document.querySelector('.page-tabs');
  if(tabs) window.scrollTo({top: tabs.offsetTop - 10, behavior:'smooth'});
};

