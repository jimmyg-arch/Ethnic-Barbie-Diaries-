/* ═══════════════════════════════════════
   CURSOR — hot pink Win98 arrow
   Fully visible, forces cursor:none everywhere
═══════════════════════════════════════ */
function initCursor(){
  /* Force cursor:none on EVERYTHING — overrides browser defaults on links/buttons/inputs */
  const cursorCSS = document.createElement('style');
  cursorCSS.id = 'y2k-cursor-css';
  cursorCSS.textContent = `
    *,*::before,*::after,
    a,button,input,select,textarea,label,
    [onclick],[role="button"],[tabindex] {
      cursor: none !important;
    }
  `;
  document.head.appendChild(cursorCSS);

  /* Build the pink pixel arrow SVG */
  const el = document.createElement('div');
  el.id = 'y2k-cursor';
  el.style.cssText = [
    'position:fixed',
    'top:-100px',        /* start off-screen until first mousemove */
    'left:-100px',
    'width:24px',
    'height:28px',
    'pointer-events:none',
    'z-index:2147483647', /* max z-index */
    'transform:translate(0,0)',
    'will-change:transform',
    'transition:none',
    'image-rendering:pixelated',
  ].join(';');

  /* Hot pink arrow — clear outline so it shows on any background */
  el.innerHTML = `<svg width="24" height="28" viewBox="0 0 24 28" xmlns="http://www.w3.org/2000/svg">
    <!-- Black outline (drawn first, slightly larger) -->
    <polygon points="2,1 2,22 7,16 11,25 15,23 11,14 18,14"
      fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
    <!-- Hot pink fill -->
    <polygon points="2,1 2,22 7,16 11,25 15,23 11,14 18,14"
      fill="#FF2D78"/>
    <!-- White highlight on top-left edge for depth -->
    <line x1="2" y1="1" x2="2" y2="22" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
    <line x1="2" y1="1" x2="18" y2="14" stroke="rgba(255,255,255,0.3)" stroke-width="1"/>
  </svg>`;

  document.body.appendChild(el);

  /* Track mouse — use pageX/pageY for scroll accuracy */
  let raf;
  document.addEventListener('mousemove', e => {
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      el.style.left = e.clientX + 'px';
      el.style.top  = e.clientY + 'px';
    });
  }, { passive: true });

  /* Hide when mouse leaves window */
  document.addEventListener('mouseleave', () => {
    el.style.opacity = '0';
  });
  document.addEventListener('mouseenter', () => {
    el.style.opacity = '1';
  });

  /* Sparkle click effect */
  document.addEventListener('click', e => {
    const sparks = ['💗','✦','★','🌸','✿','💜'];
    const s = document.createElement('div');
    s.style.cssText = [
      'position:fixed',
      `left:${e.clientX}px`,
      `top:${e.clientY}px`,
      'font-size:16px',
      'pointer-events:none',
      'z-index:2147483646',
      'transform:translate(-50%,-50%)',
      'animation:y2kSpark 0.55s ease both',
      'will-change:transform,opacity',
    ].join(';');
    s.textContent = sparks[Math.floor(Math.random() * sparks.length)];
    document.body.appendChild(s);
    setTimeout(() => s.remove(), 600);
  });

  /* Inject sparkle keyframes */
  const kf = document.createElement('style');
  kf.textContent = '@keyframes y2kSpark{from{opacity:1;transform:translate(-50%,-50%) scale(1)}to{opacity:0;transform:translate(-50%,-180%) scale(1.8)}}@keyframes popIn{from{opacity:0;transform:scale(0.88)}to{opacity:1;transform:scale(1)}}';
  document.head.appendChild(kf);
}

